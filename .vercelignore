# Vercel Deployment Ignore Configuration
# Prevents uploading the 2GB+ native macOS Swift codebase, build caches, and raw media

# macOS / SwiftPM Engine & Application Code
Sources/
Package.swift
Package.resolved
Genie.storekit
Genie.pkg
*.pkg
*.dmg
*.zip
*.app
*.entitlements
*.plist
*.icns
*.sh
*.py
*.md
.github/
.vscode/

# Heavy Non-Web Repositories & Training Sets
Marketing/
Wallpapers/
AppStore_Screenshots/
.backups/
Genie_Isolated_Build/
Consolidated_Training/
UnifiedTraining/
web/

# Build caches & temporary files
.build/
.build-mas/
build/
DerivedData/
*.tmp
*.log

# Large Raw Video Dumps (Keep only the 1080p web preview)
assets/videos/
assets/wallpapers/
assets/previews/
assets/video/*.mp4
!assets/video/App_Preview_1_Spatial_Canvas_1080p.mp4
assets/video/App_Preview_1_Spatial_Canvas_1080p_poster.png

