[
    {
        "name": "query_local_imessage_history",
        "description": "Queries the local macOS chat.db SQLite database to find historical iMessage threads, contacts, or context.",
        "parameters": {
            "type": "object",
            "properties": {
                "search_term": {
                    "type": "string"
                },
                "limit": {
