                        "Premiere",
                        "AfterEffects"
                    ]
                },
                "action": {
                    "type": "string"
                },
                "asset_path": {
                    "type": "string",
                    "description": "Absolute path to a local asset to manipulate or inject."
                }
            },
            "required": [
                "target_app",
                "action"
            ]
        }
    },
    {
        "name": "final_cut_pro_genius_edit",
