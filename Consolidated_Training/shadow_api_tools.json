                },
                "assets": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Array of absolute file paths to video/audio assets."
                },
                "timeline_name": {
                    "type": "string"
                }
            },
            "required": [
                "action",
                "assets",
                "timeline_name"
            ]
        }
