                    "default": 50
                }
            },
            "required": [
                "search_term"
            ]
        }
    },
    {
        "name": "semantic_local_file_search",
        "description": "Uses embeddings to search the local filesystem (Documents, Pictures) for files matching a semantic concept rather than exact filenames.",
        "parameters": {
            "type": "object",
            "properties": {
                "concept": {
                    "type": "string"
                },
                "file_types": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "limit": {
                    "type": "integer",
                    "default": 5
                }
            },
            "required": [
                "concept"
            ]
        }
    },
    {
        "name": "adobe_suite_expert_injection",
